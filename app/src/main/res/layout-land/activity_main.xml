<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/zero"
        android:layout_height="@dimen/zero"
        android:padding="@dimen/screen_padding"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:id="@+id/amount_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/taka_label"
                android:textSize="@dimen/amount_text_size"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/button_theme"
                style="@style/ThemeToggle"
                android:contentDescription="@string/switch_to_dark"
                app:srcCompat="@drawable/ic_dark_mode"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/amount_value"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/key_spacing"
                android:layout_marginEnd="@dimen/key_spacing"
                android:text="@string/digit_0"
                android:textSize="@dimen/amount_text_size"
                android:textColor="?attr/colorOnSurface"
                android:gravity="end"
                app:layout_constraintStart_toEndOf="@id/amount_label"
                app:layout_constraintEnd_toStartOf="@id/button_theme"
                app:layout_constraintBaseline_toBaselineOf="@id/amount_label" />


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/columns_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.35" />
            <TableLayout
                android:id="@+id/note_table"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:layout_marginEnd="@dimen/table_gap"
                android:stretchColumns="1"
                android:shrinkColumns="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/columns_guide"
                app:layout_constraintTop_toBottomOf="@id/amount_label"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0">
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        style="@style/NoteCell"
                        android:text="@string/note_header"
                        android:textStyle="bold" />
                    <TextView
                        style="@style/NoteCountCell"
                        android:text="@string/count_header"
                        android:textStyle="bold" />
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        style="@style/NoteCell"
                        android:text="@string/note_500" />
                    <TextView
                        android:id="@+id/count_500"
                        style="@style/NoteCountCell"
                        android:text="@string/digit_0" />
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        style="@style/NoteCell"
                        android:text="@string/note_100" />
                    <TextView
                        android:id="@+id/count_100"
                        style="@style/NoteCountCell"
                        android:text="@string/digit_0" />
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        style="@style/NoteCell"
                        android:text="@string/note_50" />
                    <TextView
                        android:id="@+id/count_50"
                        style="@style/NoteCountCell"
                        android:text="@string/digit_0" />
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        style="@style/NoteCell"
                        android:text="@string/note_20" />
                    <TextView
                        android:id="@+id/count_20"
                        style="@style/NoteCountCell"
                        android:text="@string/digit_0" />
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        style="@style/NoteCell"
                        android:text="@string/note_10" />
                    <TextView
                        android:id="@+id/count_10"
                        style="@style/NoteCountCell"
                        android:text="@string/digit_0" />
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        style="@style/NoteCell"
                        android:text="@string/digit_5" />
                    <TextView
                        android:id="@+id/count_5"
                        style="@style/NoteCountCell"
                        android:text="@string/digit_0" />
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        style="@style/NoteCell"
                        android:text="@string/digit_2" />
                    <TextView
                        android:id="@+id/count_2"
                        style="@style/NoteCountCell"
                        android:text="@string/digit_0" />
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        style="@style/NoteCell"
                        android:text="@string/digit_1" />
                    <TextView
                        android:id="@+id/count_1"
                        style="@style/NoteCountCell"
                        android:text="@string/digit_0" />
                </TableRow>
            </TableLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/keypad"
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            app:layout_constraintTop_toBottomOf="@id/amount_label"
            app:layout_constraintBottom_toBottomOf="@id/note_table"
            app:layout_constraintStart_toStartOf="@id/columns_guide"
            app:layout_constraintEnd_toEndOf="parent">
            <Button
                android:id="@+id/button_1"
                style="@style/VangtiKey"
                android:text="@string/digit_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/button_2"
                app:layout_constraintTop_toTopOf="parent" />
            <Button
                android:id="@+id/button_2"
                style="@style/VangtiKey"
                android:text="@string/digit_2"
                app:layout_constraintStart_toEndOf="@id/button_1"
                app:layout_constraintEnd_toStartOf="@id/button_3"
                app:layout_constraintTop_toTopOf="parent" />
            <Button
                android:id="@+id/button_3"
                style="@style/VangtiKey"
                android:text="@string/digit_3"
                app:layout_constraintStart_toEndOf="@id/button_2"
                app:layout_constraintEnd_toStartOf="@id/button_4"
                app:layout_constraintTop_toTopOf="parent" />
            <Button
                android:id="@+id/button_4"
                style="@style/VangtiKey"
                android:text="@string/digit_4"
                app:layout_constraintStart_toEndOf="@id/button_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <Button
                android:id="@+id/button_5"
                style="@style/VangtiKey"
                android:text="@string/digit_5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/button_6"
                app:layout_constraintTop_toBottomOf="@id/button_1" />
            <Button
                android:id="@+id/button_6"
                style="@style/VangtiKey"
                android:text="@string/digit_6"
                app:layout_constraintStart_toEndOf="@id/button_5"
                app:layout_constraintEnd_toStartOf="@id/button_7"
                app:layout_constraintTop_toBottomOf="@id/button_1" />
            <Button
                android:id="@+id/button_7"
                style="@style/VangtiKey"
                android:text="@string/digit_7"
                app:layout_constraintStart_toEndOf="@id/button_6"
                app:layout_constraintEnd_toStartOf="@id/button_8"
                app:layout_constraintTop_toBottomOf="@id/button_1" />
            <Button
                android:id="@+id/button_8"
                style="@style/VangtiKey"
                android:text="@string/digit_8"
                app:layout_constraintStart_toEndOf="@id/button_7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/button_1" />
            <Button
                android:id="@+id/button_9"
                style="@style/VangtiKey"
                android:text="@string/digit_9"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/button_0"
                app:layout_constraintTop_toBottomOf="@id/button_5"
                app:layout_constraintBottom_toBottomOf="parent" />
            <Button
                android:id="@+id/button_0"
                style="@style/VangtiKey"
                android:text="@string/digit_0"
                app:layout_constraintStart_toEndOf="@id/button_9"
                app:layout_constraintEnd_toStartOf="@id/button_clear"
                app:layout_constraintTop_toBottomOf="@id/button_5"
                app:layout_constraintBottom_toBottomOf="parent" />
            <Button
                android:id="@+id/button_clear"
                style="@style/VangtiKey"
                android:text="@string/clear"
                app:layout_constraintStart_toEndOf="@id/button_0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/button_5"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
